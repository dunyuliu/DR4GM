# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Frozen baseline and large data — collaborators download from figshare links in README
reference/
datasets
results/

# Per-script working dirs
src/utils/results/

# docs/dev/ holds tracked internal dev docs (audits, release notes, plans);
# docs/user/ ships publicly (e.g. FORMULAS.md) and also stays tracked.

# Scratch/working area for drafts not yet dissolved into tracked docs above.
local/
demo/

# Claude Code agent state — local only.
.claude/

# Heavy media not tracked in git
*.webm

# src/web/ local-only state — Streamlit secrets, runtime telemetry, caches
src/web/.streamlit/
src/web/usage_analytics.log
src/web/__pycache__/
src/web/.DS_Store

# UsageTracker writes usage_analytics.log relative to CWD, so running the
# app (incl. test_system/run_streamlit_boot_smoke.sh and the AppTest suite)
# from the repo root lands it at root too — same known debt as
# src/web/usage_analytics.log above (PATHWAY_FORWARD.md 2026-10-08 entry),
# just gitignored from the other CWD. Not a layout-gate violation since it
# is untracked, but keep it out of `git status` noise.
/usage_analytics.log

# Pre-move web/ dir (now src/web/) — old location still holds the owner's
# Streamlit secrets; a plain `git add -A` would otherwise publish it.
**/.streamlit/secrets.toml
web/

# Editor/OS noise
*.swp
.vscode/
.idea/
